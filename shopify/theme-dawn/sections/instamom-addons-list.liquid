{% comment %}
  InstaMom University — dynamic add-ons listing for the homepage.

  Replaces the Featured-collection section that presented add-ons as full
  product cards (with their own quick-add), which framed them as standalone
  products. Add-ons aren't bought on their own — they're chosen from the
  post-cart modal — so this just *shows what's available*: a compact,
  read-only lineup pulled live from the `add-ons` collection.

  Every add-on is listed regardless of stock, so the roster is stable.
{% endcomment %}

{{ 'instamom.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} instamom-addonlist-section">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="instamom-addonlist__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="instamom-addonlist__sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- assign addons = collections['add-ons'].products -%}
    {%- if addons.size > 0 -%}
      {%- comment -%}
        Row layout ported from the prototype's `.addon-row` (styles.css): the
        add-on name on the left, and on the right the slot the prototype used
        for its Qty select. Quantity doesn't belong here — add-ons are chosen
        from the post-cart modal, not bought from this list — so that slot
        carries the PRICE TAG instead.

        Where an add-on has a contents list, the whole row becomes a <summary>
        so clicking it expands the contents underneath, and the name carries the
        prototype's dotted underline to signal it. Add-ons without contents
        render as a plain, non-interactive row.
      {%- endcomment -%}
      <ul class="instamom-addonlist" role="list">
        {%- for addon in addons -%}
          {%- capture addon_contents -%}
            {%- render 'instamom-addon-contents', addon: addon, variant: 'items' -%}
          {%- endcapture -%}
          {%- assign addon_contents = addon_contents | strip -%}
          <li class="instamom-addonlist__item">
            {%- if addon_contents != blank -%}
              <details class="instamom-addonlist__disclosure">
                <summary class="instamom-addonlist__row instamom-addonlist__row--expandable">
                  <span class="instamom-addonlist__name">{{ addon.title | escape }}</span>
                  <span class="instamom-addonlist__price">{{ addon.price | money }}</span>
                </summary>
                {{ addon_contents }}
              </details>
            {%- else -%}
              <div class="instamom-addonlist__row">
                <span class="instamom-addonlist__name">{{ addon.title | escape }}</span>
                <span class="instamom-addonlist__price">{{ addon.price | money }}</span>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.note != blank -%}
        <p class="instamom-addonlist__note">{{ section.settings.note | escape }}</p>
      {%- endif -%}
    {%- else -%}
      <p>No add-ons found. Add products to the “add-ons” collection to list them here.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "InstaMom Add-ons list",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Available add-ons"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Customize your student's package with extra treats just for them."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Footnote",
      "default": "Choose your extras from the pop-up after you add a package to your cart."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    { "name": "InstaMom Add-ons list" }
  ]
}
{% endschema %}
