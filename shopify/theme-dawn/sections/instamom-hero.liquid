{% comment %}
  InstaMom University — hero "sticker" banner section for Dawn.
  Drop this file in the theme's /sections folder, then add it to the homepage
  via Theme editor → Add section → "InstaMom Hero".
  Styling lives in assets/instamom.css (.instamom-hero*).
{% endcomment %}

<div class="instamom-hero">
  <div class="instamom-hero__inner page-width">
    <div class="instamom-hero__banner">
      <h1 class="instamom-hero__title">{{ section.settings.heading | escape }}</h1>
    </div>

    {%- comment -%}
      Prefer a merchant-picked image from Content → Files; fall back to the
      crest bundled in the theme's own assets so the hero is never empty.
      Order matches the prototype: banner first, then crest, then badge.
    {%- endcomment -%}
    {%- if section.settings.crest != blank -%}
      <img
        class="instamom-hero__crest"
        src="{{ section.settings.crest | image_url: width: 500 }}"
        alt="{{ section.settings.crest.alt | default: section.settings.heading | escape }}"
        width="250"
        height="250"
        loading="eager"
      >
    {%- else -%}
      {%- comment -%}
        Owner review, "Wrong Crest/picture": there are two crest artworks and
        their FIGURES differ — instamom-logo-crest.png shows the pair in
        graduation caps and gowns, while instamom-logo-crest-transparent.png
        (the approved one, and what the header logo/favicon already use) shows
        them without mortarboards. This fallback pointed at the wrong one, so
        any hero placed without a crest image would render the unapproved
        artwork. Point it at the approved file.
      {%- endcomment -%}
      <img
        class="instamom-hero__crest"
        src="{{ 'instamom-logo-crest-transparent.png' | asset_url }}"
        alt="{{ section.settings.heading | escape }}"
        width="250"
        height="250"
        loading="eager"
      >
    {%- endif -%}

    {%- if section.settings.badge_text != blank -%}
      <div class="instamom-hero__badge">
        <span>{{ section.settings.badge_text | escape }}</span>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "InstaMom Hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "crest",
      "label": "Crest image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "InstaMom University"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Family Love + Faculty Wisdom"
    }
  ],
  "presets": [
    {
      "name": "InstaMom Hero"
    }
  ]
}
{% endschema %}
