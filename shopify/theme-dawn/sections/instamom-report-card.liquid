{%- style -%}
  #shopify-section-{{ section.id }} {
    --report-card-navy: var(--imu-navy, #062b66);
    --report-card-gold: var(--imu-gold, #ffc928);
    --report-card-pink: var(--imu-pink, #ed2f89);
    --report-card-cream: var(--imu-cream, #fff0b8);
    --report-card-ink: var(--imu-ink, #082b63);
  }

  .report-card {
    padding: 4.8rem 0 7.2rem;
  }

  .report-card__intro {
    max-width: 76rem;
    margin: 0 auto 3.2rem;
    text-align: center;
  }

  .report-card__eyebrow {
    display: inline-block;
    margin: 0 0 1.2rem;
    padding: 0.7rem 1.3rem;
    border-radius: 999px;
    background: var(--report-card-pink);
    color: #fff;
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .report-card__title {
    margin: 0;
    color: var(--report-card-navy);
  }

  .report-card__lede {
    max-width: 64rem;
    margin: 1.4rem auto 0;
    color: var(--report-card-ink);
    font-size: 1.8rem;
    line-height: 1.6;
  }

  .report-card__tabs {
    display: flex;
    max-width: 56rem;
    margin: 0 auto 2.8rem;
    padding: 0.6rem;
    gap: 0.8rem;
    border: 2px solid var(--report-card-navy);
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 5px 0 var(--report-card-gold);
  }

  .report-card__tab {
    display: inline-flex;
    flex: 1 1 0;
    min-height: 4.8rem;
    padding: 1rem 1.8rem;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    border: 2px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--report-card-navy);
    font-family: var(--font-heading-family);
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1.2;
    text-align: center;
    transition: background-color 140ms ease, color 140ms ease, transform 140ms ease, box-shadow 140ms ease;
  }

  .report-card__tab:hover {
    background: var(--report-card-cream);
  }

  .report-card__tab:focus-visible {
    outline: 3px solid var(--report-card-pink);
    outline-offset: 2px;
  }

  .report-card__tab[aria-selected='true'] {
    border-color: var(--report-card-navy);
    background: var(--report-card-pink);
    box-shadow: 0 3px 0 var(--report-card-navy);
    color: #fff;
  }

  .report-card__tab-badge {
    display: inline-flex;
    min-width: 2.4rem;
    height: 2.4rem;
    padding: 0 0.7rem;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--report-card-navy);
    border-radius: 999px;
    background: var(--report-card-gold);
    color: var(--report-card-navy);
    font-size: 1.2rem;
    font-weight: 800;
    line-height: 1;
  }

  .report-card__panel[hidden] {
    display: none !important;
  }

  .report-card__paper {
    position: relative;
    max-width: 88rem;
    margin: 0 auto;
    padding: 3.2rem;
    overflow: hidden;
    border: 2px solid var(--report-card-navy);
    border-radius: 2rem;
    background-color: #fffefa;
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 3.3rem,
      rgba(6, 43, 102, 0.09) 3.4rem,
      transparent 3.5rem
    );
    box-shadow: 0 0 0 3px var(--report-card-pink), 12px 12px 0 var(--report-card-gold);
  }

  .report-card__paper::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 5rem;
    width: 1px;
    background: rgba(237, 47, 137, 0.28);
    content: '';
  }

  .report-card__form,
  .report-card__reviews-wrap {
    position: relative;
  }

  .report-card__reviews-header {
    display: flex;
    margin: 0 0 2.6rem;
    padding: 1.8rem 2.2rem;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem;
    border: 2px solid var(--report-card-navy);
    border-radius: 1.4rem;
    background: var(--report-card-cream);
  }

  .report-card__reviews-summary-title {
    margin: 0;
    color: var(--report-card-navy);
    font-size: 2rem;
    font-weight: 800;
  }

  .report-card__reviews-summary-note {
    margin: 0.4rem 0 0;
    color: var(--report-card-ink);
    font-size: 1.4rem;
    line-height: 1.45;
  }

  .report-card__switch-btn {
    border: 2px solid var(--report-card-navy);
    background: var(--report-card-pink);
    box-shadow: 4px 4px 0 var(--report-card-navy);
    color: #fff;
    font-weight: 800;
  }

  .report-card__switch-btn:hover {
    background: var(--report-card-navy);
    color: #fff;
  }

  .report-card__reviews-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .report-card__review-card {
    display: flex;
    padding: 2.2rem;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.6rem;
    border: 2px solid var(--report-card-navy);
    border-radius: 1.6rem;
    background: #fff;
    box-shadow: 6px 6px 0 var(--report-card-gold);
  }

  .report-card__review-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.2rem;
  }

  .report-card__review-meta {
    min-width: 0;
  }

  .report-card__reviewer {
    margin: 0;
    color: var(--report-card-navy);
    font-family: var(--font-heading-family);
    font-size: 1.8rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .report-card__review-tags {
    display: flex;
    margin-top: 0.6rem;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .report-card__review-pill {
    display: inline-flex;
    padding: 0.35rem 0.9rem;
    align-items: center;
    border: 1.5px solid var(--report-card-navy);
    border-radius: 999px;
    background: var(--report-card-cream);
    color: var(--report-card-navy);
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .report-card__review-pill--verified {
    border-color: var(--report-card-pink);
    background: rgba(237, 47, 137, 0.1);
    color: var(--report-card-navy);
  }

  .report-card__review-stamp {
    display: flex;
    min-width: 5.4rem;
    height: 5.4rem;
    padding: 0.4rem;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--report-card-navy);
    border-radius: 1.2rem;
    background: var(--report-card-gold);
    box-shadow: 0 3px 0 var(--report-card-pink);
    color: var(--report-card-navy);
    text-align: center;
  }

  .report-card__review-stamp-letter {
    font-family: var(--font-heading-family);
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1;
  }

  .report-card__review-stamp-label {
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .report-card__review-quote {
    margin: 0;
    color: var(--report-card-ink);
    font-size: 1.55rem;
    line-height: 1.6;
  }

  .report-card__review-date {
    margin: 0;
    color: rgba(8, 43, 99, 0.72);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .report-card__empty {
    padding: 3.6rem 2.4rem;
    border: 2px dashed var(--report-card-navy);
    border-radius: 1.6rem;
    background: rgba(255, 240, 184, 0.45);
    text-align: center;
  }

  .report-card__empty-badge {
    display: inline-flex;
    width: 6.4rem;
    height: 6.4rem;
    margin: 0 auto 1.4rem;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--report-card-navy);
    border-radius: 1.6rem;
    background: var(--report-card-gold);
    box-shadow: 0 4px 0 var(--report-card-pink);
    color: var(--report-card-navy);
    font-family: var(--font-heading-family);
    font-size: 3.2rem;
    font-weight: 800;
  }

  .report-card__empty-title {
    margin: 0;
    color: var(--report-card-navy);
  }

  .report-card__empty-copy {
    max-width: 52rem;
    margin: 1rem auto 2.2rem;
    color: var(--report-card-ink);
    font-size: 1.6rem;
    line-height: 1.6;
  }

  .report-card__status {
    margin: 0 0 2.4rem;
    padding: 1.8rem 2rem;
    border: 2px solid var(--report-card-navy);
    border-radius: 1.2rem;
    background: var(--report-card-cream);
    color: var(--report-card-navy);
  }

  .report-card__status--success {
    text-align: center;
  }

  .report-card__status h2,
  .report-card__status p {
    margin: 0;
  }

  .report-card__status p {
    margin-top: 0.6rem;
  }

  .report-card__error-list {
    margin: 0.8rem 0 0;
  }

  .report-card__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.8rem;
  }

  .report-card__field,
  .report-card__grades {
    margin: 0 0 2.4rem;
  }

  .report-card__label,
  .report-card__legend {
    display: block;
    margin: 0 0 0.8rem;
    color: var(--report-card-navy);
    font-size: 1.5rem;
    font-weight: 800;
  }

  .report-card__optional {
    font-weight: 500;
  }

  .report-card__input,
  .report-card__textarea {
    width: 100%;
    border: 1.5px solid var(--report-card-navy);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.96);
    color: var(--report-card-ink);
    font: inherit;
    font-size: 1.6rem;
  }

  .report-card__input {
    min-height: 5.2rem;
    padding: 1.2rem 1.4rem;
  }

  .report-card__textarea {
    min-height: 7rem;
    padding: 1.4rem;
    resize: vertical;
  }

  .report-card__input:focus,
  .report-card__textarea:focus {
    outline: 3px solid var(--report-card-gold);
    outline-offset: 2px;
  }

  .report-card__grade-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1rem;
  }

  .report-card__grade-input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .report-card__grade-label {
    display: flex;
    min-height: 10rem;
    padding: 1.2rem 0.8rem;
    cursor: pointer;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--report-card-navy);
    border-radius: 1.2rem;
    background: #fff;
    color: var(--report-card-navy);
    text-align: center;
    transition: transform 140ms ease, box-shadow 140ms ease, background-color 140ms ease;
  }

  .report-card__grade-letter {
    font-family: var(--font-heading-family);
    font-size: 3.6rem;
    font-weight: 800;
    line-height: 1;
  }

  .report-card__grade-note {
    margin-top: 0.6rem;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .report-card__grade-label:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 0 var(--report-card-gold);
  }

  .report-card__grade-input:focus-visible + .report-card__grade-label {
    outline: 3px solid var(--report-card-pink);
    outline-offset: 3px;
  }

  .report-card__grade-input:checked + .report-card__grade-label {
    transform: translateY(-2px);
    background: var(--report-card-gold);
    box-shadow: 0 5px 0 var(--report-card-pink);
  }

  .report-card__consent {
    display: flex;
    margin: 0 0 2.4rem;
    padding: 1.4rem 1.6rem;
    align-items: flex-start;
    gap: 1.2rem;
    border: 1.5px solid var(--report-card-navy);
    border-radius: 1.2rem;
    background: rgba(255, 240, 184, 0.55);
  }

  .report-card__consent-checkbox {
    width: 2rem;
    height: 2rem;
    margin-top: 0.2rem;
    flex-shrink: 0;
    accent-color: var(--report-card-pink);
    cursor: pointer;
  }

  .report-card__consent-label {
    color: var(--report-card-ink);
    font-size: 1.45rem;
    line-height: 1.45;
    cursor: pointer;
  }

  .report-card__consent-label strong {
    color: var(--report-card-navy);
  }

  .report-card__required-note,
  .report-card__privacy {
    color: var(--report-card-ink);
    font-size: 1.3rem;
    line-height: 1.5;
  }

  .report-card__required-note {
    margin: -1rem 0 2.4rem;
  }

  .report-card__actions {
    display: flex;
    margin-top: 3rem;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
    text-align: center;
  }

  .report-card__submit {
    min-width: 25rem;
    border: 2px solid var(--report-card-navy);
    background: var(--report-card-pink);
    box-shadow: 5px 5px 0 var(--report-card-gold);
    color: #fff;
  }

  .report-card__submit:hover {
    background: var(--report-card-navy);
  }

  .report-card__submit:focus-visible {
    outline: 3px solid var(--report-card-gold);
    outline-offset: 3px;
  }

  .report-card__privacy {
    max-width: 54rem;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .report-card {
      padding: 3.2rem 0 5.6rem;
    }

    .report-card__tabs {
      flex-direction: column;
      border-radius: 1.6rem;
    }

    .report-card__paper {
      padding: 2.4rem 1.8rem;
      border-radius: 1.4rem;
      box-shadow: 0 0 0 2px var(--report-card-pink), 7px 7px 0 var(--report-card-gold);
    }

    .report-card__paper::before {
      display: none;
    }

    .report-card__reviews-header {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }

    .report-card__reviews-grid,
    .report-card__row {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .report-card__reviews-grid {
      gap: 1.6rem;
    }

    .report-card__grade-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .report-card__grade-grid > div:last-child {
      grid-column: 1 / -1;
    }

    .report-card__grade-label {
      min-height: 8.8rem;
    }

    .report-card__submit,
    .report-card__switch-btn {
      width: 100%;
      min-width: 0;
    }
  }
{%- endstyle -%}

{%- liquid
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign reviews_article = section.settings.reviews_article
  assign article_comments_count = 0
  if reviews_article != blank and reviews_article.comments_count > 0
    assign article_comments_count = reviews_article.comments_count
  endif
  assign total_reviews_count = review_blocks.size | plus: article_comments_count

  assign initial_tab = section.settings.default_tab | default: 'reviews'
  if initial_tab == 'auto'
    if total_reviews_count > 0
      assign initial_tab = 'reviews'
    else
      assign initial_tab = 'form'
    endif
  endif
-%}

<section
  class="report-card page-width"
  aria-labelledby="ReportCardTitle-{{ section.id }}"
  data-report-card-section="{{ section.id }}"
>
  <header class="report-card__intro">
    <p class="report-card__eyebrow">{{ section.settings.eyebrow | default: 'InstaMom U customer feedback' }}</p>
    <h1 class="report-card__title h0" id="ReportCardTitle-{{ section.id }}">
      {{ section.settings.heading | default: 'Grade your InstaMom experience' }}
    </h1>
    <p class="report-card__lede">
      {{
        section.settings.lede
        | default: 'No pop quiz—just an honest report card. Read what other InstaMom U families have to say, or turn in your own report card below.'
      }}
    </p>
  </header>

  <div class="report-card__tabs" role="tablist" aria-label="Customer feedback options">
    <button
      type="button"
      class="report-card__tab"
      role="tab"
      id="ReportCardTab-reviews-{{ section.id }}"
      aria-controls="ReportCardPanel-reviews-{{ section.id }}"
      aria-selected="{% if initial_tab == 'reviews' %}true{% else %}false{% endif %}"
      tabindex="{% if initial_tab == 'reviews' %}0{% else %}-1{% endif %}"
      data-report-card-tab="reviews"
    >
      <span>{{ section.settings.reviews_tab_label | default: 'Customer Reviews' }}</span>
      {%- if total_reviews_count > 0 -%}
        <span class="report-card__tab-badge" aria-label="{{ total_reviews_count }} published reviews">
          {{- total_reviews_count -}}
        </span>
      {%- endif -%}
    </button>

    <button
      type="button"
      class="report-card__tab"
      role="tab"
      id="ReportCardTab-form-{{ section.id }}"
      aria-controls="ReportCardPanel-form-{{ section.id }}"
      aria-selected="{% if initial_tab == 'form' %}true{% else %}false{% endif %}"
      tabindex="{% if initial_tab == 'form' %}0{% else %}-1{% endif %}"
      data-report-card-tab="form"
    >
      <span>{{ section.settings.form_tab_label | default: 'Leave a Review' }}</span>
    </button>
  </div>

  <div class="report-card__paper">
    <div
      id="ReportCardPanel-reviews-{{ section.id }}"
      class="report-card__panel"
      role="tabpanel"
      aria-labelledby="ReportCardTab-reviews-{{ section.id }}"
      data-report-card-panel="reviews"
      {% unless initial_tab == 'reviews' %}hidden{% endunless %}
    >
      <div class="report-card__reviews-wrap">
        <div class="report-card__reviews-header">
          <div>
            <h2 class="report-card__reviews-summary-title h3">
              {{ section.settings.reviews_heading | default: 'InstaMom U Report Cards' }}
            </h2>
            <p class="report-card__reviews-summary-note">
              {%- if total_reviews_count > 0 -%}
                Showing {{ total_reviews_count }} verified customer report {{ total_reviews_count | pluralize: 'card', 'cards' }} approved by the InstaMom U team.
              {%- else -%}
                Approved customer report cards are published here so families can see real feedback on our care packages.
              {%- endif -%}
            </p>
          </div>
          <button
            type="button"
            class="button report-card__switch-btn"
            data-report-card-switch="form"
          >
            Turn in a report card
          </button>
        </div>

        {%- if total_reviews_count > 0 -%}
          <div class="report-card__reviews-grid" role="list">
            {%- for block in review_blocks -%}
              <article
                class="report-card__review-card"
                role="listitem"
                {{ block.shopify_attributes }}
              >
                <div>
                  <div class="report-card__review-top">
                    <div class="report-card__review-meta">
                      <h3 class="report-card__reviewer">
                        {{ block.settings.reviewer_name | default: 'InstaMom U Parent' | escape }}
                      </h3>
                      <div class="report-card__review-tags">
                        {%- if block.settings.product_ordered != blank -%}
                          <span class="report-card__review-pill">
                            {{ block.settings.product_ordered | escape }}
                          </span>
                        {%- endif -%}
                        {%- if block.settings.verified_buyer -%}
                          <span class="report-card__review-pill report-card__review-pill--verified">
                            ✓ Verified Order
                          </span>
                        {%- endif -%}
                      </div>
                    </div>

                    <div
                      class="report-card__review-stamp"
                      aria-label="Overall grade {{ block.settings.grade | default: 'A' | escape }}"
                    >
                      <span class="report-card__review-stamp-letter">
                        {{ block.settings.grade | default: 'A' | escape }}
                      </span>
                      <span class="report-card__review-stamp-label">Grade</span>
                    </div>
                  </div>

                  {%- if block.settings.quote != blank -%}
                    <blockquote class="report-card__review-quote" style="margin-top: 1.4rem;">
                      “{{ block.settings.quote | escape }}”
                    </blockquote>
                  {%- endif -%}
                </div>

                {%- if block.settings.review_date != blank -%}
                  <p class="report-card__review-date">{{ block.settings.review_date | escape }}</p>
                {%- endif -%}
              </article>
            {%- endfor -%}

            {%- if reviews_article != blank and reviews_article.comments_count > 0 -%}
              {%- paginate reviews_article.comments by 50 -%}
                {%- for comment in reviews_article.comments -%}
                  <article class="report-card__review-card" role="listitem">
                    <div>
                      <div class="report-card__review-top">
                        <div class="report-card__review-meta">
                          <h3 class="report-card__reviewer">{{ comment.author | escape }}</h3>
                          <div class="report-card__review-tags">
                            <span class="report-card__review-pill report-card__review-pill--verified">
                              ✓ Approved Customer Review
                            </span>
                          </div>
                        </div>
                        <div class="report-card__review-stamp" aria-label="Customer Report Card">
                          <span class="report-card__review-stamp-letter">A</span>
                          <span class="report-card__review-stamp-label">Grade</span>
                        </div>
                      </div>
                      <div class="report-card__review-quote" style="margin-top: 1.4rem;">
                        {{ comment.content }}
                      </div>
                    </div>
                    <p class="report-card__review-date">
                      {{ comment.created_at | time_tag: format: 'date' }}
                    </p>
                  </article>
                {%- endfor -%}
              {%- endpaginate -%}
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="report-card__empty">
            <div class="report-card__empty-badge" aria-hidden="true">A+</div>
            <h3 class="report-card__empty-title h2">
              {{ section.settings.empty_heading | default: 'First semester report cards are being graded!' }}
            </h3>
            <p class="report-card__empty-copy">
              {{
                section.settings.empty_text
                | default: 'Have you sent or received an InstaMom U care package? Turn in a quick report card—once approved by our team, your review will be posted right here to help other families.'
              }}
            </p>
            <button
              type="button"
              class="button report-card__submit"
              data-report-card-switch="form"
            >
              Leave the first review
            </button>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div
      id="ReportCardPanel-form-{{ section.id }}"
      class="report-card__panel"
      role="tabpanel"
      aria-labelledby="ReportCardTab-form-{{ section.id }}"
      data-report-card-panel="form"
      {% unless initial_tab == 'form' %}hidden{% endunless %}
    >
      {%- form 'contact', id: 'InstaMomReportCard', class: 'report-card__form' -%}
        <input type="hidden" name="contact[Feedback type]" value="InstaMom Report Card">

        {%- if form.posted_successfully? -%}
          <div
            class="report-card__status report-card__status--success"
            tabindex="-1"
            autofocus
            data-report-card-force-tab="form"
          >
            <h2 class="h2">Report card received!</h2>
            <p>
              Thank you for helping InstaMom U get even better. We read every note, and approved reviews are posted to the Customer Reviews tab.
            </p>
          </div>
        {%- elsif form.errors -%}
          <div
            class="report-card__status"
            role="alert"
            tabindex="-1"
            autofocus
            data-report-card-force-tab="form"
          >
            <h2 class="h3">One quick correction, please.</h2>
            <p>Check the fields below and try turning in your report card again.</p>
            <ul class="report-card__error-list" role="list">
              {%- for field in form.errors -%}
                <li>
                  <a href="#ReportCard-{{ field | escape }}-{{ section.id }}">
                    {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="report-card__row">
          <div class="report-card__field">
            <label class="report-card__label" for="ReportCard-name-{{ section.id }}">Your name</label>
            <input
              class="report-card__input"
              autocomplete="name"
              type="text"
              id="ReportCard-name-{{ section.id }}"
              name="contact[Name]"
              placeholder="Example: Sarah M. (Class of '29 Mom)"
              value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"
            >
          </div>

          <div class="report-card__field">
            <label class="report-card__label" for="ReportCard-email-{{ section.id }}">Email <span aria-hidden="true">*</span></label>
            <input
              class="report-card__input"
              autocomplete="email"
              type="email"
              id="ReportCard-email-{{ section.id }}"
              name="contact[email]"
              value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"
              aria-required="true"
              required
            >
          </div>
        </div>

        <div class="report-card__row">
          <div class="report-card__field">
            <label class="report-card__label" for="ReportCard-order-{{ section.id }}">
              Order number <span class="report-card__optional">(optional, kept private)</span>
            </label>
            <input
              class="report-card__input"
              type="text"
              id="ReportCard-order-{{ section.id }}"
              name="contact[Order number]"
              inputmode="numeric"
              placeholder="Example: 1042"
            >
          </div>

          <div class="report-card__field">
            <label class="report-card__label" for="ReportCard-product-{{ section.id }}">
              What did you order? <span class="report-card__optional">(optional)</span>
            </label>
            <input
              class="report-card__input"
              type="text"
              id="ReportCard-product-{{ section.id }}"
              name="contact[Product purchased]"
              placeholder="Box or add-on name"
            >
          </div>
        </div>

        <fieldset class="report-card__grades">
          <legend class="report-card__legend">Overall grade <span aria-hidden="true">*</span></legend>
          <div class="report-card__grade-grid">
            <div>
              <input class="report-card__grade-input" type="radio" id="ReportCard-grade-a-{{ section.id }}" name="contact[Overall grade]" value="A — Top of the class" required>
              <label class="report-card__grade-label" for="ReportCard-grade-a-{{ section.id }}">
                <span class="report-card__grade-letter">A</span>
                <span class="report-card__grade-note">Top of the class</span>
              </label>
            </div>
            <div>
              <input class="report-card__grade-input" type="radio" id="ReportCard-grade-b-{{ section.id }}" name="contact[Overall grade]" value="B — Really good">
              <label class="report-card__grade-label" for="ReportCard-grade-b-{{ section.id }}">
                <span class="report-card__grade-letter">B</span>
                <span class="report-card__grade-note">Really good</span>
              </label>
            </div>
            <div>
              <input class="report-card__grade-input" type="radio" id="ReportCard-grade-c-{{ section.id }}" name="contact[Overall grade]" value="C — Room to grow">
              <label class="report-card__grade-label" for="ReportCard-grade-c-{{ section.id }}">
                <span class="report-card__grade-letter">C</span>
                <span class="report-card__grade-note">Room to grow</span>
              </label>
            </div>
            <div>
              <input class="report-card__grade-input" type="radio" id="ReportCard-grade-d-{{ section.id }}" name="contact[Overall grade]" value="D — Needs extra credit">
              <label class="report-card__grade-label" for="ReportCard-grade-d-{{ section.id }}">
                <span class="report-card__grade-letter">D</span>
                <span class="report-card__grade-note">Needs extra credit</span>
              </label>
            </div>
            <div>
              <input class="report-card__grade-input" type="radio" id="ReportCard-grade-f-{{ section.id }}" name="contact[Overall grade]" value="F — Please contact me">
              <label class="report-card__grade-label" for="ReportCard-grade-f-{{ section.id }}">
                <span class="report-card__grade-letter">F</span>
                <span class="report-card__grade-note">Please contact me</span>
              </label>
            </div>
          </div>
        </fieldset>

        <div class="report-card__field">
          <label class="report-card__label" for="ReportCard-body-{{ section.id }}">
            Comments about your purchase <span aria-hidden="true">*</span>
          </label>
          <textarea
            class="report-card__textarea"
            id="ReportCard-body-{{ section.id }}"
            name="contact[body]"
            rows="3"
            placeholder="What did we do well? What could make your next box even better?"
            aria-required="true"
            required
          >{{- form.body -}}</textarea>
        </div>

        <div class="report-card__field">
          <label class="report-card__label" for="ReportCard-ideas-{{ section.id }}">
            Suggest a new box <span class="report-card__optional">(optional, but highly encouraged!)</span>
          </label>
          <textarea
            class="report-card__textarea"
            id="ReportCard-ideas-{{ section.id }}"
            name="contact[New box suggestion]"
            rows="2"
            placeholder="What should InstaMom U dream up next?"
          ></textarea>
        </div>

        <div class="report-card__consent">
          <input type="hidden" name="contact[Share on Customer Reviews tab]" value="No — keep private">
          <input
            class="report-card__consent-checkbox"
            type="checkbox"
            id="ReportCard-share-{{ section.id }}"
            name="contact[Share on Customer Reviews tab]"
            value="Yes — okay to publish after approval"
            checked
          >
          <label class="report-card__consent-label" for="ReportCard-share-{{ section.id }}">
            <strong>Share my feedback with other InstaMom U families:</strong> It’s okay to feature my grade, comment, and display name on the Customer Reviews tab once approved. (Your email and order number are never shared publicly.)
          </label>
        </div>

        <p class="report-card__required-note"><span aria-hidden="true">*</span> Required field</p>

        <div class="report-card__actions">
          <button class="button report-card__submit" type="submit">Turn in my report card</button>
          <p class="report-card__privacy">
            Reviews are approved by the InstaMom U team before appearing publicly. Your email and order details remain strictly private and are used only to follow up if needed.
          </p>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

<script>
  (function () {
    const sectionEl = document.querySelector('[data-report-card-section="{{ section.id }}"]');
    if (!sectionEl) return;

    const tabs = Array.from(sectionEl.querySelectorAll('[data-report-card-tab]'));
    const panels = Array.from(sectionEl.querySelectorAll('[data-report-card-panel]'));
    const switchers = Array.from(sectionEl.querySelectorAll('[data-report-card-switch]'));

    function activateTab(targetName, focusTab) {
      tabs.forEach(function (tab) {
        const isMatch = tab.getAttribute('data-report-card-tab') === targetName;
        tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
        tab.setAttribute('tabindex', isMatch ? '0' : '-1');
        if (isMatch && focusTab) {
          tab.focus();
        }
      });

      panels.forEach(function (panel) {
        const isMatch = panel.getAttribute('data-report-card-panel') === targetName;
        if (isMatch) {
          panel.removeAttribute('hidden');
        } else {
          panel.setAttribute('hidden', '');
        }
      });
    }

    tabs.forEach(function (tab, index) {
      tab.addEventListener('click', function () {
        activateTab(tab.getAttribute('data-report-card-tab'), false);
      });

      tab.addEventListener('keydown', function (event) {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        const nextIndex =
          event.key === 'ArrowRight'
            ? (index + 1) % tabs.length
            : (index - 1 + tabs.length) % tabs.length;
        const nextTab = tabs[nextIndex];
        activateTab(nextTab.getAttribute('data-report-card-tab'), true);
      });
    });

    switchers.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const target = btn.getAttribute('data-report-card-switch');
        activateTab(target, true);
      });
    });

    if (
      sectionEl.querySelector('[data-report-card-force-tab="form"]') ||
      window.location.hash === '#InstaMomReportCard' ||
      window.location.hash === '#leave-a-review'
    ) {
      activateTab('form', false);
    } else if (window.location.hash === '#customer-reviews') {
      activateTab('reviews', false);
    }

    document.addEventListener('shopify:block:select', function (event) {
      if (sectionEl.contains(event.target)) {
        activateTab('reviews', false);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "InstaMom report card",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "InstaMom U customer feedback"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Grade your InstaMom experience"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Intro text",
      "default": "No pop quiz—just an honest report card. Read what other InstaMom U families have to say, or turn in your own report card below."
    },
    {
      "type": "select",
      "id": "default_tab",
      "label": "Default active tab",
      "options": [
        {
          "value": "reviews",
          "label": "Customer Reviews tab"
        },
        {
          "value": "form",
          "label": "Leave a Review (Report Card form) tab"
        },
        {
          "value": "auto",
          "label": "Customer Reviews when reviews exist, otherwise Leave a Review"
        }
      ],
      "default": "reviews"
    },
    {
      "type": "text",
      "id": "reviews_tab_label",
      "label": "Reviews tab label",
      "default": "Customer Reviews"
    },
    {
      "type": "text",
      "id": "form_tab_label",
      "label": "Form tab label",
      "default": "Leave a Review"
    },
    {
      "type": "text",
      "id": "reviews_heading",
      "label": "Reviews panel heading",
      "default": "InstaMom U Report Cards"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Empty state heading (when no reviews published yet)",
      "default": "First semester report cards are being graded!"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "Have you sent or received an InstaMom U care package? Turn in a quick report card—once approved by our team, your review will be posted right here to help other families."
    },
    {
      "type": "article",
      "id": "reviews_article",
      "label": "Optional blog post for moderated comments",
      "info": "If linked, any comments you approve on this blog post in Shopify Admin (Content > Blog posts > Manage comments) will also appear automatically in the Customer Reviews tab."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Approved customer review",
      "settings": [
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Customer display name",
          "default": "InstaMom U Parent",
          "info": "Use first name + last initial or parent title (never include email or order number)."
        },
        {
          "type": "text",
          "id": "product_ordered",
          "label": "Box or item ordered",
          "default": "Welcome Week Starter"
        },
        {
          "type": "select",
          "id": "grade",
          "label": "Grade",
          "options": [
            {
              "value": "A+",
              "label": "A+"
            },
            {
              "value": "A",
              "label": "A"
            },
            {
              "value": "B",
              "label": "B"
            },
            {
              "value": "C",
              "label": "C"
            }
          ],
          "default": "A"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Customer review comment"
        },
        {
          "type": "text",
          "id": "review_date",
          "label": "Date or semester (optional)",
          "placeholder": "Fall Semester"
        },
        {
          "type": "checkbox",
          "id": "verified_buyer",
          "label": "Show Verified Order badge",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "InstaMom report card"
    }
  ]
}
{% endschema %}
