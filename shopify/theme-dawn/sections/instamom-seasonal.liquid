            data-type: 'add-to-cart-form'
          -%}
            <input type="hidden" name="id" value="{{ birthday_variant.id }}">
            <button
              type="submit"
              name="add"
              class="button button--primary"
              onclick="closeSeasonalModal('modal-birthday')"
              style="width: 100%; text-align: center; justify-content: center; display: inline-flex; min-height: 48px;"
            >
              <span>Add to cart — {{ birthday_variant.price | money_without_trailing_zeros }}</span>
              {%- render 'loading-spinner' -%}
            </button>
          {%- endform -%}
        </product-form>
      {%- else -%}
        <a href="/products/seasonal-celebrations" class="button button--primary" style="width: 100%; text-align: center; justify-content: center; display: inline-flex; min-height: 48px; text-decoration: none;">Add to cart — $62</a>
      {%- endif -%}
    </div>
  </div>
</div>

<!-- Modal 2: Anything But Basic Fall Box Only -->
<div id="modal-fall" class="instamom-seasonal-modal" onclick="closeSeasonalModalOnOverlay(event, 'modal-fall')">
  <div class="instamom-seasonal-modal__content">
    <button type="button" class="instamom-seasonal-modal__close" onclick="closeSeasonalModal('modal-fall')">&times;</button>
    <div class="instamom-seasonal__image-slider-wrapper instamom-seasonal-modal__image-slider-wrapper">
      <div class="instamom-seasonal__image-slider instamom-seasonal-modal__image-slider" data-fall-modal-slider>
