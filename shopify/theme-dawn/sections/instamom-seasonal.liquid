{% comment %}
  InstaMom University — "Limited Time Only Seasonal Boxes" section with dedicated description modals.
{% endcomment %}

<style>
  .instamom-seasonal {
    margin-top: 48px;
    margin-bottom: 48px;
  }

  .instamom-seasonal__header {
    text-align: center;
    margin-bottom: 32px;
  }

  .instamom-seasonal__heading {
    font-family: 'Graduate', Georgia, serif;
    font-size: clamp(2.6rem, 2.9vw, 3.4rem);
    line-height: 1.3;
    font-weight: 800;
    color: var(--imu-navy-dark, #041d45);
    margin: 0;
  }

  .instamom-seasonal__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .instamom-seasonal__description {
    font-size: 1.4rem;
    line-height: 1.55;
    color: var(--imu-muted, #2e3d52);
    margin: 0 0 8px 0;
  }

  .instamom-seasonal__note {
    font-size: 1.3rem;
    line-height: 1.45;
    color: var(--imu-navy-dark, #041d45);
    font-style: italic;
    margin: 0 0 14px 0;
  }

  .instamom-holiday-options {
    background: rgba(4, 29, 69, 0.03);
    border: 1px solid rgba(4, 29, 69, 0.12);
    border-radius: 10px;
    padding: 12px;
    margin-bottom: 14px;
  }

  .instamom-holiday-options__group {
    margin-bottom: 10px;
  }

  .instamom-holiday-options__group:last-child {
    margin-bottom: 0;
  }

  .instamom-holiday-options__label {
    display: block;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--imu-navy-dark, #041d45);
    margin-bottom: 6px;
  }

  .instamom-holiday-options__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .instamom-holiday-pill {
    flex: 1 1 auto;
    padding: 7px 12px;
    font-size: 1.3rem;
    font-weight: 700;
    border-radius: 8px;
    border: 1.5px solid rgba(4, 29, 69, 0.2);
    background: #ffffff;
    color: var(--imu-navy-dark, #041d45);
    cursor: pointer;
    text-align: center;
    transition: all 0.15s ease;
  }

  .instamom-holiday-pill.is-selected {
    background: var(--imu-navy-dark, #041d45);
    color: #ffffff;
    border-color: var(--imu-navy-dark, #041d45);
  }

  .instamom-holiday-pill:disabled,
  .instamom-holiday-pill.is-soldout {
    opacity: 0.45;
    cursor: not-allowed;
    text-decoration: line-through;
  }

  .instamom-holiday-options__Group-hidden[hidden] {
    display: none !important;
  }

  .instamom-seasonal__card {
    background: #ffffff;
    border: 2px solid rgba(4, 29, 69, 0.12);
    border-radius: 16px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 24px rgba(4, 29, 69, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .instamom-seasonal__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(4, 29, 69, 0.12);
  }

  .instamom-seasonal__image {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 12px;
    margin-bottom: 16px;
  }

  .instamom-seasonal__badge-wrapper {
    margin-bottom: 12px;
  }

  .instamom-seasonal__card-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 12px;
  }

  .instamom-seasonal__title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.08rem, 1.9vw, 2.4rem);
    line-height: 1.25;
    font-weight: 800;
    color: var(--imu-navy-dark, #041d45);
    margin: 0;
  }

  .instamom-seasonal__price {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--imu-pink, #ed2f89);
    margin: 0;
  }

  .instamom-seasonal__card-actions {
    display: flex;
    gap: 12px;
    margin-top: auto;
  }

  .instamom-seasonal__card-actions .button {
    flex: 1;
    text-align: center;
    justify-content: center;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
  }

  /* Dedicated Modal Dialogs */
  .instamom-seasonal-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(4, 29, 69, 0.6);
    backdrop-filter: blur(4px);
    z-index: 99999;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .instamom-seasonal-modal.is-open {
    display: flex;
  }

  .instamom-seasonal-modal__content {
    background: #ffffff;
    border-radius: 20px;
    max-width: 620px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    padding: 32px;
    position: relative;
    box-shadow: 0 20px 50px rgba(4, 29, 69, 0.25);
  }

  .instamom-seasonal-modal__close {
    position: absolute;
    top: 16px;
    right: 20px;
    background: transparent;
    border: none;
    font-size: 2rem;
    font-weight: bold;
    color: var(--imu-navy-dark, #041d45);
    cursor: pointer;
    line-height: 1;
  }

  .instamom-seasonal-modal__image {
    width: 100%;
    max-height: 280px;
    object-fit: cover;
    border-radius: 12px;
    margin-bottom: 20px;
  }

  .instamom-seasonal-modal__title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 16px;
  }

  .instamom-seasonal-modal__title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--imu-navy-dark, #041d45);
    margin: 0;
  }

  .instamom-seasonal-modal__price {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--imu-pink, #ed2f89);
    margin: 0;
  }

  .instamom-seasonal-modal__subtitle {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--imu-navy-dark, #041d45);
    margin-top: 16px;
    margin-bottom: 10px;
  }

  .instamom-seasonal-modal__list {
    margin: 0 0 24px 0;
    padding-left: 20px;
    color: var(--imu-muted, #2e3d52);
    line-height: 1.6;
  }

  .instamom-seasonal-modal__list li {
    margin-bottom: 6px;
  }

  /* Create your own box card */
  .instamom-create-box {
    margin-top: 40px;
    max-width: 880px;
    margin-left: auto;
    margin-right: auto;
  }

  .instamom-create-box__card {
    background: #ffffff;
    border: 2px solid rgba(4, 29, 69, 0.12);
    border-radius: 16px;
    padding: 32px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 32px;
    box-shadow: 0 8px 24px rgba(4, 29, 69, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .instamom-create-box__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(4, 29, 69, 0.12);
  }

  .instamom-create-box__image-wrapper {
    flex: 0 0 280px;
    max-width: 280px;
    width: 100%;
  }

  .instamom-create-box__image {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 12px;
    display: block;
  }

  .instamom-create-box__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .instamom-create-box__title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.08rem, 1.9vw, 2.4rem);
    line-height: 1.25;
    font-weight: 800;
    color: var(--imu-navy-dark, #041d45);
    margin: 0 0 12px 0;
  }

  .instamom-create-box__description {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--imu-muted, #2e3d52);
    margin: 0 0 20px 0;
  }

  .instamom-create-box__action {
    margin-top: auto;
  }

  .instamom-create-box__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 28px;
    font-weight: 700;
    text-decoration: none;
  }

  @media screen and (max-width: 749px) {
    .instamom-create-box__card {
      flex-direction: column;
      padding: 24px;
      gap: 20px;
      text-align: center;
    }

    .instamom-create-box__image-wrapper {
      flex: 0 0 auto;
      max-width: 100%;
    }

    .instamom-create-box__content {
      align-items: center;
    }

    .instamom-create-box__title {
      font-size: 2rem;
    }
  }
</style>

{%- comment -%} Prioritize Standalone Products so items appear cleanly in cart without parent bundle title {%- endcomment -%}
{%- assign target_fall_product = all_products['anything-but-basic-fall-care-package'] | default: all_products['anything-but-basic-fall-box'] | default: all_products['fall-care-package'] -%}
{%- assign fall_variant = nil -%}
{%- if target_fall_product != blank -%}
  {%- assign fall_variant = target_fall_product.first_available_variant | default: target_fall_product.variants.first -%}
{%- else -%}
  {%- for p in collections.all.products -%}
    {%- assign p_handle = p.handle | downcase -%}
    {%- assign p_title = p.title | downcase -%}
    {%- if p_handle contains 'fall' or p_title contains 'fall' -%}
      {%- unless p_handle == 'seasonal-celebrations' -%}
        {%- assign target_fall_product = p -%}
        {%- assign fall_variant = p.first_available_variant | default: p.variants.first -%}
        {%- break -%}
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- comment -%} Fallback to variant in seasonal-celebrations bundle if standalone is missing {%- endcomment -%}
{%- if fall_variant == blank -%}
  {%- assign seasonal_bundle = all_products['seasonal-celebrations'] -%}
  {%- if seasonal_bundle != blank -%}
    {%- for v in seasonal_bundle.variants -%}
      {%- assign v_title = v.title | downcase -%}
      {%- if v_title contains 'fall' or v_title contains 'autumn' or v_title contains 'basic' -%}
        {%- assign target_fall_product = seasonal_bundle -%}
        {%- assign fall_variant = v -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endif -%}

{%- assign target_birthday_product = all_products['birthday-care-package'] | default: all_products['birthday-box'] -%}
{%- assign birthday_variant = nil -%}
{%- if target_birthday_product != blank -%}
  {%- assign birthday_variant = target_birthday_product.first_available_variant | default: target_birthday_product.variants.first -%}
{%- else -%}
  {%- for p in collections.all.products -%}
    {%- assign p_handle = p.handle | downcase -%}
    {%- assign p_title = p.title | downcase -%}
    {%- if p_handle contains 'birthday' or p_title contains 'birthday' -%}
      {%- unless p_handle == 'seasonal-celebrations' -%}
        {%- assign target_birthday_product = p -%}
        {%- assign birthday_variant = p.first_available_variant | default: p.variants.first -%}
        {%- break -%}
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if birthday_variant == blank -%}
  {%- assign seasonal_bundle = all_products['seasonal-celebrations'] -%}
  {%- if seasonal_bundle != blank -%}
    {%- for v in seasonal_bundle.variants -%}
      {%- assign v_title = v.title | downcase -%}
      {%- if v_title contains 'birthday' -%}
        {%- assign target_birthday_product = seasonal_bundle -%}
        {%- assign birthday_variant = v -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endif -%}

{%- assign protein_product = all_products['protein-fiend-college-care-package'] | default: all_products['protein-fiend-box'] | default: all_products['protein-fiend'] -%}
{%- if protein_product == blank -%}
  {%- for p in collections.all.products -%}
    {%- assign p_title = p.title | downcase -%}
    {%- assign p_handle = p.handle | downcase -%}
    {%- if p_title contains 'protein' or p_handle contains 'protein' -%}
      {%- assign protein_product = p -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- assign protein_variant = nil -%}
{%- if protein_product != blank -%}
  {%- assign protein_variant = protein_product.selected_or_first_available_variant -%}
{%- endif -%}

{%- assign target_holiday_love_product = all_products['spread-the-holiday-love'] | default: all_products['holiday-love'] -%}
{%- if target_holiday_love_product == blank -%}
  {%- for p in collections.all.products -%}
    {%- assign p_handle = p.handle | downcase -%}
    {%- assign p_title = p.title | downcase -%}
    {%- if p_handle contains 'holiday-love' or p_title contains 'spread the holiday love' -%}
      {%- assign target_holiday_love_product = p -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- assign hl_mini_variant = nil -%}
{%- assign hl_ivory_variant = nil -%}
{%- assign hl_red_variant = nil -%}
{%- assign hl_green_variant = nil -%}
{%- assign hl_gray_variant = nil -%}
{%- if target_holiday_love_product != blank -%}
  {%- for v in target_holiday_love_product.variants -%}
    {%- assign vt = v.title | downcase -%}
    {%- if vt contains 'mini' -%}
      {%- assign hl_mini_variant = v -%}
    {%- elsif vt contains 'ivory' -%}
      {%- assign hl_ivory_variant = v -%}
    {%- elsif vt contains 'red' -%}
      {%- assign hl_red_variant = v -%}
    {%- elsif vt contains 'green' -%}
      {%- assign hl_green_variant = v -%}
    {%- elsif vt contains 'gray' or vt contains 'grey' -%}
      {%- assign hl_gray_variant = v -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- assign hl_default_variant = hl_mini_variant | default: target_holiday_love_product.selected_or_first_available_variant | default: target_holiday_love_product.variants.first -%}

<div class="instamom-seasonal page-width">
  <div class="instamom-seasonal__header">
    <h2 class="instamom-seasonal__heading">{{ section.settings.heading | default: 'Limited Time Only Seasonal Boxes' | escape }}</h2>
  </div>

  <div class="instamom-seasonal__grid">
    <!-- Spread the Holiday Love -->
    <div class="instamom-seasonal__card" data-holiday-love-container="card">
      <div class="instamom-seasonal__badge-wrapper">
        {% render 'instamom-badge', modifier: 'seasonal', label: 'Seasonal' %}
      </div>
      <div class="instamom-seasonal__image-slider-wrapper">
        <div class="instamom-seasonal__image-slider" data-holiday-love-slider>
          <img src="{{ 'instamom-holiday-love-1.jpg' | asset_url }}" alt="Spread the Holiday Love Photo 1" class="instamom-seasonal__image" loading="lazy">
          <img src="{{ 'instamom-holiday-love-2.jpg' | asset_url }}" alt="Spread the Holiday Love Photo 2" class="instamom-seasonal__image" loading="lazy">
          <img src="{{ 'instamom-holiday-love-3.jpg' | asset_url }}" alt="Spread the Holiday Love Scarf Colors" class="instamom-seasonal__image" loading="lazy">
        </div>
        <div class="instamom-seasonal__slider-dots">
          <span class="instamom-seasonal__dot is-active"></span>
          <span class="instamom-seasonal__dot"></span>
          <span class="instamom-seasonal__dot"></span>
        </div>
        <button type="button" class="instamom-seasonal__slider-arrow instamom-seasonal__slider-arrow--prev" onclick="scrollSeasonalSlider('holiday-love', -1)" aria-label="Previous photo">&lsaquo;</button>
        <button type="button" class="instamom-seasonal__slider-arrow instamom-seasonal__slider-arrow--next" onclick="scrollSeasonalSlider('holiday-love', 1)" aria-label="Next photo">&rsaquo;</button>
      </div>
      <div class="instamom-seasonal__card-title-row">
        <h3 class="instamom-seasonal__title">Spread the Holiday Love</h3>
        <p class="instamom-seasonal__price" data-hl-price>$15</p>
      </div>
      <p class="instamom-seasonal__description">
        Share some love with people around you--teachers, mail carriers, neighbors, or whoever has brightened your days throughout the year! Choose the Mini Bag or the Deluxe Bag.
      </p>
      <p class="instamom-seasonal__note">
        <em>Because these are offered at cost, a minimum order of three bags is required per shipping address.</em>
      </p>
      <div class="instamom-holiday-options">
        <div class="instamom-holiday-options__group">
          <span class="instamom-holiday-options__label">Choose Bag:</span>
          <div class="instamom-holiday-options__pills">
            <button
              type="button"
              class="instamom-holiday-pill is-selected"
              data-hl-bag="mini"
              data-variant-id="{{ hl_mini_variant.id }}"
              data-available="{{ hl_mini_variant.available | default: true }}"
              onclick="selectHolidayLoveBag('mini')"
            >
              Mini Bag — $15
            </button>
            <button
              type="button"
              class="instamom-holiday-pill"
              data-hl-bag="deluxe"
              onclick="selectHolidayLoveBag('deluxe')"
            >
              Deluxe Bag — $25
            </button>
          </div>
        </div>
        <div class="instamom-holiday-options__group instamom-holiday-options__Group-hidden" data-hl-scarf-group hidden>
          <span class="instamom-holiday-options__label">Choose Scarf Color:</span>
          <div class="instamom-holiday-options__pills">
            <button
              type="button"
              class="instamom-holiday-pill is-selected{% if hl_ivory_variant != blank and hl_ivory_variant.available == false %} is-soldout{% endif %}"
              data-hl-scarf="ivory"
              data-variant-id="{{ hl_ivory_variant.id }}"
              data-available="{{ hl_ivory_variant.available | default: true }}"
              {% if hl_ivory_variant != blank and hl_ivory_variant.available == false %}disabled{% endif %}
              onclick="selectHolidayLoveScarf('ivory')"
            >
              Ivory
            </button>
            <button
              type="button"
              class="instamom-holiday-pill{% if hl_red_variant != blank and hl_red_variant.available == false %} is-soldout{% endif %}"
              data-hl-scarf="red"
              data-variant-id="{{ hl_red_variant.id }}"
              data-available="{{ hl_red_variant.available | default: true }}"
              {% if hl_red_variant != blank and hl_red_variant.available == false %}disabled{% endif %}
              onclick="selectHolidayLoveScarf('red')"
            >
              Red
            </button>
            <button
              type="button"
              class="instamom-holiday-pill{% if hl_green_variant != blank and hl_green_variant.available == false %} is-soldout{% endif %}"
              data-hl-scarf="green"
              data-variant-id="{{ hl_green_variant.id }}"
              data-available="{{ hl_green_variant.available | default: true }}"
              {% if hl_green_variant != blank and hl_green_variant.available == false %}disabled{% endif %}
              onclick="selectHolidayLoveScarf('green')"
            >
              Green
            </button>
            <button
              type="button"
              class="instamom-holiday-pill{% if hl_gray_variant != blank and hl_gray_variant.available == false %} is-soldout{% endif %}"
              data-hl-scarf="gray"
              data-variant-id="{{ hl_gray_variant.id }}"
              data-available="{{ hl_gray_variant.available | default: true }}"
              {% if hl_gray_variant != blank and hl_gray_variant.available == false %}disabled{% endif %}
              onclick="selectHolidayLoveScarf('gray')"
            >
              Gray
            </button>
          </div>
        </div>
      </div>
      <div class="instamom-seasonal__card-actions">
        <button type="button" class="button button--secondary" onclick="openSeasonalModal('modal-holiday-love')">Explore package</button>
        {%- if hl_default_variant != blank and target_holiday_love_product != blank -%}
          <product-form data-section-id="{{ section.id }}" style="flex: 1;">
            {%- form 'product',
              target_holiday_love_product,
              id: 'card-holiday-love-form',
              class: 'form',
              novalidate: 'novalidate',
              data-type: 'add-to-cart-form'
            -%}
              <input type="hidden" name="id" value="{{ hl_default_variant.id }}" data-hl-variant-input>
              <button
                type="submit"
                name="add"
                class="button button--primary"
                data-hl-submit-btn
                style="width: 100%; text-align: center; justify-content: center; display: inline-flex;"
              >
                <span data-hl-submit-label>Add to cart</span>
                {%- render 'loading-spinner' -%}
              </button>
            {%- endform -%}
          </product-form>
        {%- else -%}
          <a href="{{ target_holiday_love_product.url | default: '/products/spread-the-holiday-love' }}" class="button button--primary">Add to cart</a>
        {%- endif -%}
      </div>
    </div>

    <!-- Birthday Box -->
    <div class="instamom-seasonal__card">
      <div class="instamom-seasonal__badge-wrapper">
        {% render 'instamom-badge', modifier: 'seasonal', label: 'Seasonal' %}
      </div>
      <div class="instamom-seasonal__image-slider-wrapper">
        <div class="instamom-seasonal__image-slider" data-birthday-slider>
          <img src="{{ 'instamom-birthday-box-real.jpg' | asset_url }}" alt="Birthday Box Photo 1" class="instamom-seasonal__image" loading="lazy">
          <img src="{{ 'instamom-birthday-box-2.jpg' | asset_url }}" alt="Birthday Box Photo 2" class="instamom-seasonal__image" loading="lazy">
          <img src="{{ 'instamom-birthday-box-3.jpg' | asset_url }}" alt="Birthday Box Photo 3" class="instamom-seasonal__image" loading="lazy">
        </div>
        <div class="instamom-seasonal__slider-dots">
          <span class="instamom-seasonal__dot is-active"></span>
          <span class="instamom-seasonal__dot"></span>
          <span class="instamom-seasonal__dot"></span>
        </div>
        <button type="button" class="instamom-seasonal__slider-arrow instamom-seasonal__slider-arrow--prev" onclick="scrollSeasonalSlider('birthday', -1)" aria-label="Previous photo">&lsaquo;</button>
        <button type="button" class="instamom-seasonal__slider-arrow instamom-seasonal__slider-arrow--next" onclick="scrollSeasonalSlider('birthday', 1)" aria-label="Next photo">&rsaquo;</button>
      </div>
      <div class="instamom-seasonal__card-title-row">
        <h3 class="instamom-seasonal__title">Birthday Box</h3>
        <p class="instamom-seasonal__price">$62</p>
      </div>
      <div class="instamom-seasonal__card-actions">
