      price: 15,
      max: {{ hl_mini_variant.inventory_quantity | default: 40 | json }},
      available: {{ hl_mini_variant.available | default: true | json }}
    },
    ivory: {
      id: {{ hl_ivory_variant.id | default: 0 | json }},
      label: 'Deluxe (Ivory)',
      price: 25,
      max: {{ hl_ivory_variant.inventory_quantity | default: 6 | json }},
      available: {{ hl_ivory_variant.available | default: true | json }}
    },
    red: {
      id: {{ hl_red_variant.id | default: 0 | json }},
      label: 'Deluxe (Red)',
      price: 25,
      max: {{ hl_red_variant.inventory_quantity | default: 3 | json }},
      available: {{ hl_red_variant.available | default: true | json }}
    },
    green: {
      id: {{ hl_green_variant.id | default: 0 | json }},
      label: 'Deluxe (Green)',
      price: 25,
      max: {{ hl_green_variant.inventory_quantity | default: 6 | json }},
      available: {{ hl_green_variant.available | default: true | json }}
    },
    gray: {
      id: {{ hl_gray_variant.id | default: 0 | json }},
      label: 'Deluxe (Gray)',
      price: 25,
      max: {{ hl_gray_variant.inventory_quantity | default: 3 | json }},
      available: {{ hl_gray_variant.available | default: true | json }}
    }
  };

  var holidayLoveState = {
    bag: 'mini',
    userAdjusted: false,
    qtys: {
      mini: 3,
      ivory: 0,
      red: 0,
      green: 0,
      gray: 0
    }
  };

  function getHolidayLoveTotals() {
    var keys = ['mini', 'ivory', 'red', 'green', 'gray'];
    var totalBags = 0;
    var totalPrice = 0;
    var parts = [];
    keys.forEach(function (k) {
      var q = holidayLoveState.qtys[k] || 0;
      if (q > 0) {
        totalBags += q;
        totalPrice += q * holidayLoveVariants[k].price;
        parts.push(q + '\u00d7 ' + holidayLoveVariants[k].label);
      }
    });
    return {
      totalBags: totalBags,
      totalPrice: totalPrice,
      parts: parts
    };
  }

  function syncHolidayLoveUI() {
    var totals = getHolidayLoveTotals();
    var containers = document.querySelectorAll('[data-holiday-love-container]');
    containers.forEach(function (container) {
      var bagBtns = container.querySelectorAll('[data-hl-bag]');
      bagBtns.forEach(function (btn) {
        if (btn.getAttribute('data-hl-bag') === holidayLoveState.bag) {
          btn.classList.add('is-selected');
        } else {
          btn.classList.remove('is-selected');
        }
      });

      var miniGroup = container.querySelector('[data-hl-mini-group]');
      var scarfGroup = container.querySelector('[data-hl-scarf-group]');
      if (holidayLoveState.bag === 'deluxe') {
        if (miniGroup) miniGroup.setAttribute('hidden', '');
        if (miniGroup) miniGroup.classList.add('instamom-holiday-options__Group-hidden');
        if (scarfGroup) scarfGroup.removeAttribute('hidden');
      } else {
        if (miniGroup) miniGroup.removeAttribute('hidden');
        if (miniGroup) miniGroup.classList.remove('instamom-holiday-options__Group-hidden');
        if (scarfGroup) scarfGroup.setAttribute('hidden', '');
      }

      var keys = ['mini', 'ivory', 'red', 'green', 'gray'];
      keys.forEach(function (k) {
        var q = holidayLoveState.qtys[k] || 0;
        var valEl = container.querySelector('[data-hl-qty="' + k + '"]');
        if (valEl) valEl.textContent = String(q);
        var rowEl = container.querySelector('[data-hl-item-row="' + k + '"]');
        if (rowEl) {
          if (q > 0) {
            rowEl.classList.add('is-active-qty');
          } else {
            rowEl.classList.remove('is-active-qty');
          }
          var btns = rowEl.querySelectorAll('.instamom-hl-stepper__btn');
          if (btns.length === 2) {
            btns[0].disabled = q <= 0;
            var maxForKey = holidayLoveVariants[k].available === false ? 0 : Math.max(0, holidayLoveVariants[k].max);
            btns[1].disabled = q >= maxForKey || totals.totalBags >= 40;
          }
        }
      });

      var summaryEl = container.querySelector('[data-hl-summary]');
      if (summaryEl) {
        if (totals.totalBags < 3) {
          var needed = 3 - totals.totalBags;
          summaryEl.classList.add('is-unmet');
          summaryEl.innerHTML =
            'Minimum 3 bags required: <strong>' +
            totals.totalBags +
            ' of 3 selected</strong> — add ' +
            needed +
            ' more (Mini or Deluxe)' +
            (totals.parts.length ? ' [' + totals.parts.join(', ') + ']' : '');
        } else {
          summaryEl.classList.remove('is-unmet');
          summaryEl.innerHTML =
            'Selected: <strong>' +
            totals.totalBags +
            ' bags ($' +
            totals.totalPrice +
            ')</strong> — ' +
            totals.parts.join(', ');
        }
      }

      var submitBtn = container.querySelector('[data-hl-submit-btn]');
      var submitLabel = container.querySelector('[data-hl-submit-label]');
      if (submitBtn && submitLabel) {
        var isModalBtn = submitLabel.hasAttribute('data-hl-modal-btn');
        if (totals.totalBags < 3) {
          var rem = 3 - totals.totalBags;
          submitBtn.disabled = true;
          submitLabel.textContent = 'Select ' + rem + ' more bag' + (rem === 1 ? '' : 's') + ' (Min. 3)';
        } else {
          submitBtn.disabled = false;
          submitLabel.textContent = isModalBtn
            ? 'Add ' + totals.totalBags + ' bags to cart — $' + totals.totalPrice
            : 'Add ' + totals.totalBags + ' bags to cart';
        }
      }
    });
  }

  function selectHolidayLoveBag(bagType) {
    holidayLoveState.bag = bagType;
    if (!holidayLoveState.userAdjusted) {
      if (bagType === 'deluxe') {
        holidayLoveState.qtys.mini = 0;
        holidayLoveState.qtys.ivory = Math.min(3, holidayLoveVariants.ivory.max || 3);
        holidayLoveState.qtys.red = 0;
        holidayLoveState.qtys.green = 0;
        holidayLoveState.qtys.gray = 0;
      } else {
        holidayLoveState.qtys.mini = 3;
        holidayLoveState.qtys.ivory = 0;
        holidayLoveState.qtys.red = 0;
        holidayLoveState.qtys.green = 0;
        holidayLoveState.qtys.gray = 0;
      }
    }
    syncHolidayLoveUI();
  }

  function adjustHolidayLoveQty(key, delta) {
    holidayLoveState.userAdjusted = true;
    var current = holidayLoveState.qtys[key] || 0;
    var totals = getHolidayLoveTotals();
    var maxForKey = holidayLoveVariants[key].available === false ? 0 : Math.max(0, holidayLoveVariants[key].max);
    var next = current + delta;
    if (next < 0) next = 0;
    if (next > maxForKey) next = maxForKey;
    if (delta > 0 && totals.totalBags >= 40) return;
    holidayLoveState.qtys[key] = next;
    syncHolidayLoveUI();
  }

  function submitHolidayLoveOrder(evt, fromModal) {
    if (evt) evt.preventDefault();
    var totals = getHolidayLoveTotals();
    if (totals.totalBags < 3) return;

    var items = [];
    ['mini', 'ivory', 'red', 'green', 'gray'].forEach(function (k) {
      var q = holidayLoveState.qtys[k] || 0;
      var vid = holidayLoveVariants[k].id;
      if (q > 0 && vid) {
        items.push({ id: vid, quantity: q });
      }
    });
    if (!items.length) return;

    var btns = document.querySelectorAll('[data-hl-submit-btn]');
    btns.forEach(function (b) {
      b.disabled = true;
      b.classList.add('loading');
      var sp = b.querySelector('.loading__spinner');
      if (sp) sp.classList.remove('hidden');
    });

    var cart = document.querySelector('cart-notification') || document.querySelector('cart-drawer');
    var payload = { items: items };
    if (cart && typeof cart.getSectionsToRender === 'function') {
      payload.sections = cart.getSectionsToRender().map(function (s) {
        return s.id;
      });
      payload.sections_url = window.location.pathname;
    }

    var rootUrl = window.Shopify && window.Shopify.routes && window.Shopify.routes.root ? window.Shopify.routes.root : '/';
    fetch(rootUrl + 'cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Accept: 'application/json'
      },
      body: JSON.stringify(payload)
    })
      .then(function (r) {
        return r.json();
      })
      .then(function (res) {
        if (fromModal) {
          closeSeasonalModal('modal-holiday-love');
        }
        if (res.status && res.description) {
          alert(res.description);
          return;
        }
        if (cart && typeof cart.renderContents === 'function' && res.sections) {
          if (cart.classList.contains('is-empty')) cart.classList.remove('is-empty');
          cart.renderContents({
            id: items[0].id,
            sections: res.sections
          });
        } else {
          window.location.href = rootUrl + 'cart';
        }
      })
      .catch(function () {
        window.location.href = rootUrl + 'cart';
      })
      .finally(function () {
        btns.forEach(function (b) {
          b.disabled = false;
          b.classList.remove('loading');
          var sp = b.querySelector('.loading__spinner');
          if (sp) sp.classList.add('hidden');
        });
        syncHolidayLoveUI();
      });
  }

  function openSeasonalModal(id) {
    var modal = document.getElementById(id);
    if (modal) modal.classList.add('is-open');
  }

  function closeSeasonalModal(id) {
    var modal = document.getElementById(id);
    if (modal) modal.classList.remove('is-open');
  }

  function closeSeasonalModalOnOverlay(e, id) {
    if (e.target.id === id) {
      closeSeasonalModal(id);
    }
  }

  function scrollSeasonalSlider(prefix, direction) {
    var slider = document.querySelector('[data-' + prefix + '-slider]');
    if (!slider) return;
    var width = slider.clientWidth;
    slider.scrollBy({ left: direction * width, behavior: 'smooth' });
  }

  function initSeasonalSliderDots(prefix) {
    var slider = document.querySelector('[data-' + prefix + '-slider]');
    if (!slider) return;
    var wrapper = slider.closest('.instamom-seasonal__image-slider-wrapper');
    if (!wrapper) return;
    var dots = wrapper.querySelectorAll('.instamom-seasonal__dot');

    function sync() {
      var width = slider.clientWidth;
      if (!width) return;
      var index = Math.round(slider.scrollLeft / width);
      dots.forEach(function (dot, i) {
        if (i === index) {
          dot.classList.add('is-active');
        } else {
          dot.classList.remove('is-active');
        }
      });
    }

    slider.addEventListener('scroll', sync, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () {
      initSeasonalSliderDots('holiday-love');
      initSeasonalSliderDots('holiday-love-modal');
      initSeasonalSliderDots('birthday');
      initSeasonalSliderDots('birthday-modal');
      initSeasonalSliderDots('fall');
      initSeasonalSliderDots('fall-modal');
      syncHolidayLoveUI();
    });
  } else {
    initSeasonalSliderDots('holiday-love');
    initSeasonalSliderDots('holiday-love-modal');
    initSeasonalSliderDots('birthday');
    initSeasonalSliderDots('birthday-modal');
    initSeasonalSliderDots('fall');
    initSeasonalSliderDots('fall-modal');
    syncHolidayLoveUI();
  }
</script>

