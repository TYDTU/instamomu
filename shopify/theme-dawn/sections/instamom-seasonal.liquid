      </div>
      <button type="button" class="instamom-seasonal__slider-arrow instamom-seasonal__slider-arrow--prev" onclick="scrollSeasonalSlider('fall-modal', -1)" aria-label="Previous photo">&lsaquo;</button>
      <button type="button" class="instamom-seasonal__slider-arrow instamom-seasonal__slider-arrow--next" onclick="scrollSeasonalSlider('fall-modal', 1)" aria-label="Next photo">&rsaquo;</button>
    </div>
    <div class="instamom-seasonal-modal__title-row">
      <h3 class="instamom-seasonal-modal__title">Anything But Basic Fall Box</h3>
      <p class="instamom-seasonal-modal__price">$64</p>
    </div>
    <h4 class="instamom-seasonal-modal__subtitle">What's Inside:</h4>
    <ul class="instamom-seasonal-modal__list">
