              type="submit"
              name="add"
              class="button button--primary"
              data-hl-submit-btn
              onclick="closeSeasonalModal('modal-holiday-love')"
              style="width: 100%; text-align: center; justify-content: center; display: inline-flex; min-height: 48px;"
            >
              <span data-hl-submit-label data-hl-modal-btn>Add to cart — $15</span>
              {%- render 'loading-spinner' -%}
            </button>
          {%- endform -%}
        </product-form>
      {%- else -%}
        <a href="{{ target_holiday_love_product.url | default: '/products/spread-the-holiday-love' }}" class="button button--primary" style="width: 100%; text-align: center; justify-content: center; display: inline-flex; min-height: 48px; text-decoration: none;">Add to cart — $15</a>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  var holidayLoveState = {
    bag: 'mini',
    scarf: 'ivory'
  };

  function syncHolidayLoveUI() {
    var containers = document.querySelectorAll('[data-holiday-love-container]');
    containers.forEach(function (container) {
      var bagBtns = container.querySelectorAll('[data-hl-bag]');
      bagBtns.forEach(function (btn) {
        if (btn.getAttribute('data-hl-bag') === holidayLoveState.bag) {
          btn.classList.add('is-selected');
        } else {
          btn.classList.remove('is-selected');
        }
      });

      var scarfGroup = container.querySelector('[data-hl-scarf-group]');
      if (scarfGroup) {
        if (holidayLoveState.bag === 'deluxe') {
          scarfGroup.removeAttribute('hidden');
        } else {
          scarfGroup.setAttribute('hidden', '');
        }
      }

      var scarfBtns = container.querySelectorAll('[data-hl-scarf]');
      scarfBtns.forEach(function (btn) {
        if (btn.getAttribute('data-hl-scarf') === holidayLoveState.scarf) {
          btn.classList.add('is-selected');
        } else {
          btn.classList.remove('is-selected');
        }
      });

      var priceText = holidayLoveState.bag === 'deluxe' ? '$25' : '$15';
      var priceEl = container.querySelector('[data-hl-price]');
      if (priceEl) priceEl.textContent = priceText;

      var activeBtn =
        holidayLoveState.bag === 'mini'
          ? container.querySelector('[data-hl-bag="mini"]')
          : container.querySelector('[data-hl-scarf="' + holidayLoveState.scarf + '"]');

      var variantInput = container.querySelector('[data-hl-variant-input]');
      var submitBtn = container.querySelector('[data-hl-submit-btn]');
      var submitLabel = container.querySelector('[data-hl-submit-label]');
      if (activeBtn && variantInput) {
        var vid = activeBtn.getAttribute('data-variant-id');
        var avail = activeBtn.getAttribute('data-available') !== 'false';
        if (vid) variantInput.value = vid;
        if (submitBtn && submitLabel) {
          var isModalBtn = submitLabel.hasAttribute('data-hl-modal-btn');
          if (!avail) {
            submitBtn.disabled = true;
            submitLabel.textContent = 'Sold out';
          } else {
            submitBtn.disabled = false;
            submitLabel.textContent = isModalBtn ? 'Add to cart — ' + priceText : 'Add to cart';
          }
        }
      }
    });
  }

  function selectHolidayLoveBag(bagType) {
    holidayLoveState.bag = bagType;
    if (bagType === 'deluxe') {
      var currentScarfBtn = document.querySelector('[data-hl-scarf="' + holidayLoveState.scarf + '"]');
      if (currentScarfBtn && currentScarfBtn.disabled) {
        var firstAvail = document.querySelector('[data-hl-scarf]:not([disabled])');
        if (firstAvail) {
          holidayLoveState.scarf = firstAvail.getAttribute('data-hl-scarf');
        }
      }
    }
    syncHolidayLoveUI();
  }

  function selectHolidayLoveScarf(color) {
    holidayLoveState.scarf = color;
    holidayLoveState.bag = 'deluxe';
    syncHolidayLoveUI();
  }

  function openSeasonalModal(id) {
    var modal = document.getElementById(id);
    if (modal) modal.classList.add('is-open');
  }

  function closeSeasonalModal(id) {
    var modal = document.getElementById(id);
    if (modal) modal.classList.remove('is-open');
  }

  function closeSeasonalModalOnOverlay(e, id) {
    if (e.target.id === id) {
      closeSeasonalModal(id);
    }
  }

  function scrollSeasonalSlider(prefix, direction) {
    var slider = document.querySelector('[data-' + prefix + '-slider]');
    if (!slider) return;
    var width = slider.clientWidth;
    slider.scrollBy({ left: direction * width, behavior: 'smooth' });
  }

  function initSeasonalSliderDots(prefix) {
    var slider = document.querySelector('[data-' + prefix + '-slider]');
    if (!slider) return;
    var wrapper = slider.closest('.instamom-seasonal__image-slider-wrapper');
    if (!wrapper) return;
    var dots = wrapper.querySelectorAll('.instamom-seasonal__dot');

    function sync() {
      var width = slider.clientWidth;
      if (!width) return;
      var index = Math.round(slider.scrollLeft / width);
      dots.forEach(function (dot, i) {
        if (i === index) {
          dot.classList.add('is-active');
        } else {
          dot.classList.remove('is-active');
        }
      });
    }

    slider.addEventListener('scroll', sync, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () {
      initSeasonalSliderDots('holiday-love');
      initSeasonalSliderDots('holiday-love-modal');
      initSeasonalSliderDots('birthday');
      initSeasonalSliderDots('birthday-modal');
      initSeasonalSliderDots('fall');
      initSeasonalSliderDots('fall-modal');
      syncHolidayLoveUI();
    });
  } else {
    initSeasonalSliderDots('holiday-love');
    initSeasonalSliderDots('holiday-love-modal');
    initSeasonalSliderDots('birthday');
    initSeasonalSliderDots('birthday-modal');
    initSeasonalSliderDots('fall');
    initSeasonalSliderDots('fall-modal');
    syncHolidayLoveUI();
  }
</script>

{% schema %}
{
  "name": "InstaMom Seasonal Boxes",
  "tag": "section",
  "class": "section-instamom-seasonal",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Limited Time Only Seasonal Boxes"
    }
  ],
  "presets": [
    {
      "name": "InstaMom Seasonal Boxes"
    }
  ]
}
{% endschema %}
