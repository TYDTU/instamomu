<script>
  function openSeasonalModal(id) {
    var modal = document.getElementById(id);
    if (modal) modal.classList.add('is-open');
  }

  function closeSeasonalModal(id) {
    var modal = document.getElementById(id);
    if (modal) modal.classList.remove('is-open');
  }

  function closeSeasonalModalOnOverlay(e, id) {
    if (e.target.id === id) {
      closeSeasonalModal(id);
    }
  }

  function scrollSeasonalSlider(prefix, direction) {
    var slider = document.querySelector('[data-' + prefix + '-slider]');
    if (!slider) return;
    var width = slider.clientWidth;
    slider.scrollBy({ left: direction * width, behavior: 'smooth' });
  }

  function initSeasonalSliderDots(prefix) {
    var slider = document.querySelector('[data-' + prefix + '-slider]');
    if (!slider) return;
    var wrapper = slider.closest('.instamom-seasonal__image-slider-wrapper');
    if (!wrapper) return;
    var dots = wrapper.querySelectorAll('.instamom-seasonal__dot');

    function sync() {
      var width = slider.clientWidth;
      if (!width) return;
      var index = Math.round(slider.scrollLeft / width);
      dots.forEach(function (dot, i) {
        if (i === index) {
          dot.classList.add('is-active');
        } else {
          dot.classList.remove('is-active');
        }
      });
    }

    slider.addEventListener('scroll', sync, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () {
      initSeasonalSliderDots('birthday');
      initSeasonalSliderDots('birthday-modal');
      initSeasonalSliderDots('fall');
      initSeasonalSliderDots('fall-modal');
    });
  } else {
    initSeasonalSliderDots('birthday');
    initSeasonalSliderDots('birthday-modal');
    initSeasonalSliderDots('fall');
    initSeasonalSliderDots('fall-modal');
  }
</script>

