{% comment %}
  InstaMom University — hold the express wallet buttons (Shop Pay, Apple Pay,
  Google Pay) until the required candy preference, fun-extras profanity
  preference, and Terms agreement are given.

  WHY THIS EXISTS RATHER THAN A CLICK GUARD

  The candy-preference, profanity-preference, and terms guards stop the standard Checkout button by
  listening for clicks on `#checkout, .cart__dynamic-checkout-buttons`. That
  works for the standard button, and it worked for the product page's Shop Pay
  button, which was ordinary DOM. It does NOT work here: Shopify renders the
  cart's accelerated checkout as <shopify-accelerated-checkout-cart>, whose
  buttons live inside two IFRAMES. Clicks inside an iframe never reach this
  document, so there is nothing for a guard to intercept — a shopper could skip
  the allergy answer, fun-extras answer, and Terms tick-box entirely and still
  check out.

  So instead of trying to catch the click, the buttons aren't there to click.
  #main-cart-footer carries `instamom-wallets-locked` until both preferences
  and the Terms agreement are given, and the CSS hides the wallet row while
  that class is present.

  The lock is rendered SERVER-SIDE from the cart attributes, so it is already in
  place before this script runs — otherwise there'd be a window on every page
  load where the wallets were live and unguarded.

  With JavaScript off the wallets stay hidden, which is the safe direction to
  fail: the standard Checkout button still works, carries both answers via
  form="cart", and enforces them with the inputs' own `required`.

  Styling: .instamom-wallet-gate* in assets/instamom.css
{% endcomment %}

<p class="instamom-wallet-gate" data-wallet-gate>
  Choose your candy and fun-extras preferences, then agree to the Terms above,
  to pay with Shop&nbsp;Pay or another express wallet. You can also use the
  Checkout button.
</p>

<script>
  (function () {
    var footer = document.getElementById('main-cart-footer');
    if (!footer) return;

    function candyChosen() {
      return !!document.querySelector('input[name="attributes[Candy preference]"]:checked');
    }

    function termsAgreed() {
      var box = document.getElementById('InstamomTermsAgree');
      return !!box && box.checked;
    }

    function profanityChosen() {
      return !!document.querySelector('input[name="attributes[Fun extras profanity preference]"]:checked');
    }

    function sync() {
      footer.classList.toggle('instamom-wallets-locked', !(candyChosen() && profanityChosen() && termsAgreed()));
    }

    // All three controls live in sibling snippets, so listen at the document
    // rather than reaching into any one of them.
    document.addEventListener('change', function (event) {
      if (!event.target.closest) return;
      if (event.target.closest('#instamom-candy, #instamom-profanity, #instamom-terms')) sync();
    });

    // The preference radios and the terms box are restored from cart attributes
    // on load, so re-check once the DOM is parsed rather than trusting the class
    // Liquid rendered — they can disagree if an attribute was cleared.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', sync);
    } else {
      sync();
    }
  })();
</script>
